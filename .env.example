# Copy to .env (do not commit .env)

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-1-...

# Airtable
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# Airtable table IDs for route-based retrieval
AIRTABLE_PROJECTS_TABLE_ID=tbl...
AIRTABLE_TASKS_TABLE_ID=tbl...
AIRTABLE_STAFF_TABLE_ID=tbl...
AIRTABLE_CONTACTS_TABLE_ID=tbl...

# Ollama — local on the VM/host.
# Docker Compose: omit OLLAMA_BASE_URL unless you need to override it.
# Plain local Python run can use:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# Chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_N_RESULTS=5
CHROMA_FILTER_TO_PROJECTS_TABLE=false

# App settings
MAX_SLACK_CHARS=3500
LOG_LEVEL=INFO